<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF6F0">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1A1208"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#C8922A"
            android:textSize="14sp"
            android:paddingEnd="16dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ARTWORK DETAIL"
            android:textColor="#FAF6F0"
            android:textSize="13sp"
            android:letterSpacing="0.2"
            android:gravity="center"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Image Gallery -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="280dp"/>

            <!-- Dot indicator -->
            <LinearLayout
                android:id="@+id/dotsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingVertical="6dp"/>

            <!-- ID & Style -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp">

                <TextView
                    android:id="@+id/tvProductId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#999"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:background="#C8922A"/>
            </LinearLayout>

            <!-- Name -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1208"
                android:paddingHorizontal="16dp"
                android:paddingTop="6dp"/>

            <!-- Price & Material -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#C8922A"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/tvMaterial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#555"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Shilpi -->
            <TextView
                android:id="@+id/tvShilpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#555"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:textSize="13sp"/>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E0D8CC" android:layout_margin="16dp"/>

            <!-- Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#333"
                android:lineSpacingMultiplier="1.6"
                android:paddingHorizontal="16dp"/>

            <!-- Heritage Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Heritage Story"
                android:textStyle="bold"
                android:textColor="#1A1208"
                android:textSize="15sp"
                android:background="#F0E8D8"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/tvHeritage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#555"
                android:lineSpacingMultiplier="1.6"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"/>

            <!-- Timeline Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Work-in-Progress Timeline"
                android:textStyle="bold"
                android:textColor="#1A1208"
                android:textSize="15sp"
                android:background="#F0E8D8"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTimeline"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:nestedScrollingEnabled="false"/>

            <!-- Buttons -->
            <Button
                android:id="@+id/btnInquire"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:text="📩  ENQUIRE VIA WHATSAPP"
                android:backgroundTint="#25D366"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnShare"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="SHARE THIS ARTWORK"
                android:backgroundTint="#1A1208"
                android:textColor="#C8922A"
                android:textStyle="bold"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>